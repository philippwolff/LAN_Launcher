<Window x:Class="LanLauncher.Server.Gui.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="LAN Party Server" Width="940" Height="630" MinWidth="720" MinHeight="480" Background="#242831" Foreground="#F1F3F7" FontFamily="Tahoma" WindowStartupLocation="CenterScreen">
<Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Border Background="#000080" Padding="14" Margin="0,0,0,12"><TextBlock Text="LAN PARTY SERVER" FontSize="21" FontWeight="Bold" Foreground="White"/></Border>
<Border Grid.Row="1" Background="#333946" Padding="12" Margin="0,0,0,12"><DockPanel LastChildFill="True"><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button x:Name="StartButton" Content="Server starten" Click="Start_Click" Padding="14,7" Margin="6,0"/><Button x:Name="StopButton" Content="Server stoppen" Click="Stop_Click" Padding="14,7" Margin="6,0" IsEnabled="False"/></StackPanel><StackPanel><TextBlock x:Name="StatusText" Text="Status: Gestoppt" FontWeight="Bold" FontSize="15"/><TextBlock x:Name="AddressText" Text="Adresse: http://127.0.0.1:8080" Margin="0,6,0,0"/></StackPanel></DockPanel></Border>
<Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<GroupBox Header="Aktive Verbindungen" Foreground="#F1F3F7" BorderBrush="#646C7B" Margin="0,0,6,0"><DockPanel Margin="8"><TextBlock x:Name="PlayerCountText" Text="0 Spieler online" DockPanel.Dock="Top" Margin="0,0,0,8"/><ListView x:Name="PlayersList" Background="#333946" Foreground="White" BorderBrush="#646C7B"><ListView.View><GridView><GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}" Width="160"/><GridViewColumn Header="Status" DisplayMemberBinding="{Binding Status}" Width="160"/></GridView></ListView.View></ListView></DockPanel></GroupBox>
<GroupBox Header="Hochgeladene Spiele" Grid.Column="1" Foreground="#F1F3F7" BorderBrush="#646C7B" Margin="6,0,0,0"><DockPanel Margin="8"><TextBlock x:Name="GameCountText" Text="0 Spiele" DockPanel.Dock="Top" Margin="0,0,0,8"/><ListView x:Name="GamesList" Background="#333946" Foreground="White" BorderBrush="#646C7B"><ListView.View><GridView><GridViewColumn Header="Spiel" DisplayMemberBinding="{Binding Name}" Width="200"/><GridViewColumn Header="Version" DisplayMemberBinding="{Binding Version}" Width="90"/></GridView></ListView.View></ListView></DockPanel></GroupBox>
</Grid><TextBlock Grid.Row="3" x:Name="FooterText" Foreground="#B5BDCC" Text="Aktualisierung alle 3 Sekunden • Server-Daten bleiben im Storage-Ordner erhalten." Margin="0,12,0,0"/></Grid></Window>