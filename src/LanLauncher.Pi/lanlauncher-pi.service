[Unit]
Description=LAN Launcher Raspberry Pi NAS Management Server
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/mnt/lanlauncher-nas

[Service]
Type=simple
User=root
WorkingDirectory=/opt/lanlauncher-pi
ExecStart=/usr/bin/python3 /opt/lanlauncher-pi/server.py --admin-key-file /etc/lanlauncher/admin-key
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=false
ReadWritePaths=/mnt/lanlauncher-nas
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
