<Window x:Class="LanLauncher.Client.GameStartNoticeWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Starthinweis bearbeiten (Admin)" Width="570" Height="365" MinWidth="450" MinHeight="300" WindowStartupLocation="CenterOwner">
<Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<TextBlock x:Name="GameTitle" FontWeight="Bold" FontSize="15" Margin="0,0,0,12"/>
<TextBox x:Name="NoticeBox" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxLength="2000" Padding="8"/>
<TextBlock Grid.Row="2" Text="Der Hinweis erscheint nach jedem erfolgreichen Spielstart. Leerer Text deaktiviert das Popup. Maximal 2000 Zeichen." TextWrapping="Wrap" Margin="0,10,0,12"/>
<StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Abbrechen" Width="110" Margin="0,0,10,0" IsCancel="True"/><Button Content="Speichern" Width="110" IsDefault="True" Click="Save_Click"/></StackPanel>
</Grid></Window>