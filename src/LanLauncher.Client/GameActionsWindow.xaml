<Window x:Class="LanLauncher.Client.GameActionsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Spielaktionen" Width="740" Height="650" MinWidth="620" MinHeight="570" WindowStartupLocation="CenterOwner"><StackPanel Margin="18"><GroupBox Header="Ausgewähltes Spiel" Padding="12" Margin="0,0,0,14"><StackPanel><TextBlock x:Name="GameTitle" FontSize="17" FontWeight="Bold" Margin="0,0,0,12"/><TextBlock x:Name="TagsText" TextWrapping="Wrap" Foreground="Black" Margin="0,0,0,8"/></StackPanel></GroupBox><GroupBox Header="Aktionen" Padding="12"><StackPanel><Button x:Name="StartButton" Content="Starten" Click="Start_Click" Padding="8" Margin="0,0,0,8"/><Button x:Name="DownloadAndInstallButton" Content="Herunterladen und installieren" Click="Install_Click" Padding="8" Margin="0,0,0,8"/><Button x:Name="LocalInstallButton" Content="Installieren (heruntergeladenes Paket)" Click="LocalInstall_Click" IsEnabled="False" Padding="8" Margin="0,0,0,8"/><Button x:Name="DownloadButton" Content="Nur Paket herunterladen" Click="Download_Click" Padding="8" Margin="0,0,0,8"/><Button x:Name="UninstallButton" Content="Spiel deinstallieren" Click="Uninstall_Click" Padding="8" Margin="0,0,0,8"/><Button x:Name="AdminButton" Content="Admin" Click="Admin_Click" Padding="8" Margin="0,0,0,8"/><StackPanel x:Name="AdminActionsPanel" Visibility="Collapsed" Margin="14,0,0,4"><Button x:Name="DeleteButton" Content="Vom Server löschen" Click="Delete_Click" Padding="8" Margin="0,0,0,8"/><Button x:Name="ModButton" Content="Mod zuordnen" Click="Mod_Click" Padding="8" Margin="0,0,0,8"/><Button x:Name="NoticeButton" Content="Starthinweis bearbeiten" Click="Notice_Click" Padding="8" Margin="0,0,0,8"/><Button x:Name="TagsButton" Content="Tags bearbeiten" Click="Tags_Click" Padding="8" Margin="0,0,0,8"/></StackPanel><Button Content="Einstellungen" Click="Settings_Click" Padding="8" Margin="0,0,0,8"/><Button Content="Schließen" Click="Close_Click" Padding="8"/></StackPanel></GroupBox></StackPanel></Window>