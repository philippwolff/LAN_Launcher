<Window x:Class="LanLauncher.Client.GameActionsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Spielaktionen" Width="570" Height="625" MinWidth="500" MinHeight="580" WindowStartupLocation="CenterOwner"><StackPanel Margin="18"><GroupBox Header="Ausgewähltes Spiel" Padding="12" Margin="0,0,0,14"><StackPanel><TextBlock x:Name="GameTitle" FontSize="17" FontWeight="Bold" Margin="0,0,0,12"/><TextBlock x:Name="TagsText" TextWrapping="Wrap" Foreground="Black" Margin="0,0,0,8"/></StackPanel></GroupBox><GroupBox Header="Aktionen" Padding="12"><StackPanel><Button x:Name="StartButton" Content="Starten" Click="Start_Click" Padding="8" Margin="0,0,0,8"/><Button Content="Herunterladen und installieren" Click="Install_Click" Padding="8" Margin="0,0,0,8"/><Button Content="Nur Paket herunterladen" Click="Download_Click" Padding="8" Margin="0,0,0,8"/><Button Content="Vom Server löschen (Admin)" Click="Delete_Click" Padding="8" Margin="0,0,0,8"/><Button x:Name="UninstallButton" Content="Spiel deinstallieren" Click="Uninstall_Click" Padding="8" Margin="0,0,0,8"/><Button Content="Mod zuordnen (Admin)" Click="Mod_Click" Padding="8" Margin="0,0,0,8"/><Button Content="Tags bearbeiten (Admin)" Click="Tags_Click" Padding="8" Margin="0,0,0,8"/><Button Content="Einstellungen" Click="Settings_Click" Padding="8" Margin="0,0,0,8"/><Button Content="Schließen" Click="Close_Click" Padding="8"/></StackPanel></GroupBox></StackPanel></Window>