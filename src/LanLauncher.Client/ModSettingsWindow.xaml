<Window x:Class="LanLauncher.Client.ModSettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Mod zuordnen (Admin)" Width="670" Height="410" WindowStartupLocation="CenterOwner">
<StackPanel Margin="18">
<TextBlock Text="Hauptspiel (muss bereits installiert sein):" FontWeight="Bold" Margin="0,0,0,5"/>
<ComboBox x:Name="BaseGameBox" DisplayMemberPath="Name" Margin="0,0,0,15" Height="30"/>
<TextBlock Text="Start-EXE des Mods (relativ zum Hauptspielordner):" FontWeight="Bold" Margin="0,0,0,5"/>
<TextBox x:Name="LauncherBox" Text="Blitzkrieg Launcher.exe" Margin="0,0,0,15" Height="28"/>
<TextBlock Text="Installationsschritte (relative EXE-Pfade im ZIP, ein Schritt pro Zeile):" FontWeight="Bold" Margin="0,0,0,5"/>
<TextBox x:Name="StepsBox" Height="125" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap" Margin="0,0,0,12"/>
<TextBlock Text="Die Schritte werden nacheinander gestartet. Der Mod wird in denselben Ordner wie das Hauptspiel installiert." TextWrapping="Wrap" Margin="0,0,0,10"/>
<DockPanel LastChildFill="False"><Button Content="? Hilfe" Width="110" Height="30" HorizontalAlignment="Left" DockPanel.Dock="Left" Click="Help_Click"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right"><Button Content="Abbrechen" Width="110" Margin="0,0,10,0" IsCancel="True"/><Button Content="Speichern" Width="110" IsDefault="True" Click="Save_Click"/></StackPanel></DockPanel>
</StackPanel></Window>