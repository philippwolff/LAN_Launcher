<Window x:Class="LanLauncher.Client.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Einstellungen" Width="680" Height="330" MinWidth="590" MinHeight="300" WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
<Grid Margin="18">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<TextBlock Text="Standardordner" FontSize="16" FontWeight="Bold" Margin="0,0,0,16"/>
<Grid Grid.Row="1" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/><ColumnDefinition Width="105"/></Grid.ColumnDefinitions>
<TextBlock Text="Installationsort:" VerticalAlignment="Center"/>
<TextBox x:Name="InstallPathBox" Grid.Column="1" VerticalContentAlignment="Center" Margin="0,0,10,0"/>
<Button Grid.Column="2" Content="Durchsuchen …" Click="BrowseInstall_Click" Padding="5"/>
</Grid>
<Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/><ColumnDefinition Width="105"/></Grid.ColumnDefinitions>
<TextBlock Text="Downloadort:" VerticalAlignment="Center"/>
<TextBox x:Name="DownloadPathBox" Grid.Column="1" VerticalContentAlignment="Center" Margin="0,0,10,0"/>
<Button Grid.Column="2" Content="Durchsuchen …" Click="BrowseDownload_Click" Padding="5"/>
</Grid>
<StackPanel Grid.Row="3" Margin="0,14,0,0"><CheckBox x:Name="DarkModeCheckBox" Content="Dark Mode (dunkles Design)" VerticalAlignment="Center" Margin="0,0,0,12"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,18,0,0">
<Button Content="Abbrechen" Width="105" Padding="6" Margin="0,0,10,0" Click="Cancel_Click"/>
<Button Content="Speichern" Width="105" Padding="6" IsDefault="True" Click="Save_Click"/>
</StackPanel></StackPanel>
</Grid></Window>