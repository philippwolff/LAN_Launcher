<Window x:Class="LanLauncher.Client.GameTestWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Spieltest dokumentieren" Width="470" Height="240" MinWidth="420" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Loaded="Window_Loaded">
<StackPanel Margin="18">
<TextBlock Text="Testergebnis für dieses Spiel auf dem Server speichern:" TextWrapping="Wrap" Margin="0,0,0,14"/>
<CheckBox x:Name="TestedBox" Content="Spiel getestet" Margin="0,0,0,12" Checked="Tested_Changed" Unchecked="Tested_Changed"/>
<TextBlock Text="Betriebssystem:" Margin="0,0,0,5"/>
<TextBox x:Name="OsBox" Margin="0,0,0,16"/>
<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
<Button Content="Abbrechen" Width="100" Margin="0,0,10,0" Click="Cancel_Click"/>
<Button Content="Speichern" Width="110" IsDefault="True" Click="Save_Click"/>
</StackPanel>
</StackPanel></Window>