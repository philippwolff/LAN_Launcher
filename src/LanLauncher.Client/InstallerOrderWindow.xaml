<Window x:Class="LanLauncher.Client.InstallerOrderWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Mehrstufige Spielinstallation" Width="850" Height="590" MinWidth="650" MinHeight="420" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
<Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<TextBlock Text="Installationsreihenfolge festlegen: Eintrag auswählen und mit den Pfeilen verschieben. Die Programme werden nacheinander ausgeführt." TextWrapping="Wrap" Margin="0,0,0,12"/>
<Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<ListBox x:Name="InstallersList" DisplayMemberPath="Display" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Auto" SelectionChanged="InstallersList_SelectionChanged"/>
<StackPanel Grid.Column="1" Margin="12,0,0,0"><Button x:Name="UpButton" Content="▲ Hoch" Width="105" Margin="0,0,0,8" Click="Up_Click"/><Button x:Name="DownButton" Content="▼ Runter" Width="105" Click="Down_Click"/></StackPanel></Grid>
<TextBlock Grid.Row="2" Text="Achtung: Installationsprogramme nur ausführen, wenn du der Quelle vertraust. Schließe jeden Installationsassistenten vollständig ab, bevor der nächste startet." TextWrapping="Wrap" Margin="0,14,0,12"/>
<StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Abbrechen" Width="115" Margin="0,0,10,0" Click="Cancel_Click"/><Button Content="Installation beginnen" Width="165" IsDefault="True" Click="Confirm_Click"/></StackPanel>
</Grid></Window>