<Window x:Class="LanLauncher.Client.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="LAN Party Launcher" Width="900" Height="650" MinWidth="700" MinHeight="500">
<Grid Margin="20">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<TextBlock Text="LAN PARTY LAUNCHER" FontSize="26" FontWeight="Bold" Margin="0,0,0,16"/>
<StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12"><TextBlock Text="Server:" VerticalAlignment="Center"/><TextBox x:Name="ServerBox" Width="180" Margin="8,0,16,0" Text="127.0.0.1:8080"/><TextBlock Text="Benutzer:" VerticalAlignment="Center"/><TextBox x:Name="NameBox" Width="150" Margin="8,0,12,0"/><Button Content="Verbinden" Padding="14,6" Click="Connect_Click"/></StackPanel>
<TextBlock Grid.Row="2" x:Name="StatusText" Text="Nicht verbunden" Margin="0,0,0,14"/>
<Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><GroupBox Header="Spielebibliothek" Margin="0,0,8,0"><DockPanel><StackPanel DockPanel.Dock="Bottom" Margin="6"><Button Content="Herunterladen und installieren" Padding="8" Margin="0,0,0,6" Click="Install_Click"/><Button Content="Nur Paket herunterladen" Padding="8" Margin="0,0,0,6" Click="Download_Click"/><Button Content="Spiel vom Server löschen (Admin)" Padding="8" Click="DeleteGame_Click"/></StackPanel><ListBox x:Name="GamesList" DisplayMemberPath="Name" Margin="6"/></DockPanel></GroupBox><GroupBox Header="Spieler online" Grid.Column="1" Margin="8,0,0,0"><ListBox x:Name="PlayersList" Margin="6"/></GroupBox></Grid>
<GroupBox Header="Admin – Spiele hinzufügen" Grid.Row="4" Margin="0,12,0,0"><StackPanel Margin="8"><StackPanel Orientation="Horizontal" Margin="0,0,0,6"><TextBlock Text="Admin-Schlüssel:" VerticalAlignment="Center"/><PasswordBox x:Name="AdminKeyBox" Width="190" Margin="8,0,16,0"/><TextBlock Text="Spielname:" VerticalAlignment="Center"/><TextBox x:Name="GameNameBox" Width="180" Margin="8,0,16,0"/><TextBlock Text="Version:" VerticalAlignment="Center"/><TextBox x:Name="GameVersionBox" Width="80" Text="1.0" Margin="8,0,0,0"/></StackPanel><StackPanel Orientation="Horizontal"><Button Content="ZIP/EXE hochladen" Click="Upload_Click" Padding="12,6" Margin="0,0,8,0"/><Button Content="Server-Inbox prüfen" Click="Inbox_Click" Padding="12,6" Margin="0,0,8,0"/><ComboBox x:Name="InboxFiles" Width="230" Margin="0,0,8,0"/><Button Content="Aus Inbox importieren" Click="Import_Click" Padding="12,6"/></StackPanel></StackPanel></GroupBox>
</Grid></Window>