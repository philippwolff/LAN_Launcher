<Window x:Class="LanLauncher.Client.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:LanLauncher.Client" Title="LAN Party Launcher" Width="1400" Height="900" MinWidth="1050" MinHeight="700">
<Window.Resources><local:GameIconConverter x:Key="GameIconConverter"/><local:GameDisplayNameConverter x:Key="GameDisplayNameConverter"/><local:GameNotInstalledConverter x:Key="GameNotInstalledConverter"/></Window.Resources>
<Grid Margin="20">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Border Background="#000080" BorderBrush="#FFFFFF" BorderThickness="1" Margin="0,0,0,16" Padding="10,8"><DockPanel LastChildFill="False"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="LAN PARTY LAUNCHER" FontFamily="Tahoma" FontSize="20" FontWeight="Bold" Foreground="White"/><TextBlock x:Name="LauncherVersionText" Text="" FontFamily="Tahoma" FontSize="12" Foreground="#D8D8FF" Margin="12,0,0,1" VerticalAlignment="Bottom"/></StackPanel><Button x:Name="UpdateButton" Content="Updates prüfen" Click="Update_Click" DockPanel.Dock="Right" HorizontalAlignment="Right" Padding="12,4" Margin="12,0,0,0" ToolTip="Aktuelle Windows-Version auf GitHub Actions herunterladen"/></DockPanel></Border>
<StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12"><TextBlock Text="Server:" VerticalAlignment="Center"/><TextBox x:Name="ServerBox" Width="180" Margin="8,0,16,0" Text="127.0.0.1:8080"/><TextBlock Text="Benutzer:" VerticalAlignment="Center"/><TextBox x:Name="NameBox" Width="150" Margin="8,0,12,0"/><Button Content="Verbinden" Padding="14,6" Click="Connect_Click" IsDefault="True"/><Button Content="⚙ Einstellungen" Padding="14,6" Margin="12,0,0,0" Click="Settings_Click"/></StackPanel>
<TextBlock Grid.Row="2" x:Name="StatusText" Text="Nicht verbunden" Margin="0,0,0,14"/>
<Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions><GroupBox Header="Spielebibliothek" Margin="0,0,8,0"><DockPanel><StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,6,6,2"><TextBlock Text="Filter:" VerticalAlignment="Center" Margin="0,0,6,0"/><ComboBox x:Name="PlayerFilter" Foreground="Black" Width="125" Margin="0,0,8,0" SelectionChanged="TagFilter_Changed"/><ComboBox x:Name="GenreFilter" Foreground="Black" Width="175" Margin="0,0,8,0" SelectionChanged="TagFilter_Changed"/><Button Content="Zurücksetzen" Padding="8,4" Click="ResetTagFilter_Click"/></StackPanel><ListBox x:Name="GamesList" Margin="6" SelectionChanged="GamesList_SelectionChanged" MouseDoubleClick="GamesList_MouseDoubleClick">
<ListBox.ItemContainerStyle>
<Style TargetType="{x:Type ListBoxItem}">
<Setter Property="Foreground" Value="Black"/>
<Setter Property="Background" Value="White"/>
<Setter Property="Padding" Value="4,4"/>
<Style.Triggers>
<DataTrigger Binding="{Binding Converter={StaticResource GameNotInstalledConverter}}" Value="True"><Setter Property="Background" Value="#A9CFFF"/></DataTrigger>
<Trigger Property="IsSelected" Value="True">
<Setter Property="Background" Value="#D6E8FF"/>
<Setter Property="Foreground" Value="Black"/>
</Trigger>
</Style.Triggers>
</Style>
</ListBox.ItemContainerStyle>
<ListBox.ItemTemplate>
<DataTemplate>
<StackPanel Orientation="Horizontal">
<Image Source="{Binding Converter={StaticResource GameIconConverter}}" Width="18" Height="18" Margin="0,0,7,0" Stretch="Uniform"/>
<TextBlock Text="{Binding Converter={StaticResource GameDisplayNameConverter}}" Foreground="#000000" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
</StackPanel>
</DataTemplate>
</ListBox.ItemTemplate>
</ListBox></DockPanel></GroupBox><GroupBox Header="Spielaktionen" Grid.Column="1" Margin="4,0,4,0"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="8"><TextBlock x:Name="SelectedGameTitle" Text="Kein Spiel ausgewählt" TextWrapping="Wrap" FontWeight="Bold" Margin="0,0,0,10"/><Button x:Name="ActionStartButton" Content="Starten" Click="ActionStart_Click" Padding="6" Margin="0,0,0,6"/><Button Content="Herunterladen und installieren" Click="ActionInstall_Click" Padding="6" Margin="0,0,0,6"/><Button Content="Installieren (lokales Paket)" Click="ActionLocalInstall_Click" Padding="6" Margin="0,0,0,6"/><Button Content="Nur Paket herunterladen" Click="ActionDownload_Click" Padding="6" Margin="0,0,0,6"/><Button x:Name="ActionUninstallButton" Content="Spiel deinstallieren" Click="ActionUninstall_Click" Padding="6" Margin="0,0,0,6"/><Button Content="Einstellungen" Click="ActionSettings_Click" Padding="6" Margin="0,0,0,6"/><Button Content="Eintrag ausblenden" Click="HideGame_Click" Padding="6" Margin="0,0,0,6"/><Button Content="Ausgeblendete Einträge wiederherstellen" Click="RestoreHiddenGames_Click" Padding="6" Margin="0,0,0,6"/><GroupBox Header="Teststatus" Margin="0,8,0,6"><TextBlock x:Name="SelectedGameTestStatus" Text="Kein Spiel ausgewählt." TextWrapping="Wrap" Margin="6"/></GroupBox><GroupBox Header="Starthinweise" Margin="0,8,0,6"><TextBox x:Name="SelectedGameStartNotice" Text="Spiel auswählen, um Starthinweise anzuzeigen." IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" MinHeight="85" MaxHeight="180" Margin="4" Padding="6"/></GroupBox><Expander Header="Admin" Margin="0,6,0,0"><StackPanel Margin="4"><Button Content="Vom Server löschen" Click="ActionDelete_Click" Margin="0,0,0,6"/><Button Content="Mod zuordnen" Click="ActionMod_Click" Margin="0,0,0,6"/><Button Content="Starthinweis bearbeiten" Click="ActionNotice_Click" Margin="0,0,0,6"/><Button Content="Teststatus bearbeiten" Click="ActionTestStatus_Click" Margin="0,0,0,6"/><Button Content="Tags bearbeiten" Click="ActionTags_Click"/></StackPanel></Expander></StackPanel></ScrollViewer></GroupBox><GroupBox Header="Spieler online" Grid.Column="2" Margin="8,0,0,0"><ListBox x:Name="PlayersList" Margin="6"/></GroupBox></Grid>
<GroupBox Header="Admin – Spiele hinzufügen" Grid.Row="4" Margin="0,12,0,0"><StackPanel Margin="8"><StackPanel Orientation="Horizontal" Margin="0,0,0,6"><TextBlock Text="Admin-Schlüssel:" VerticalAlignment="Center"/><PasswordBox x:Name="AdminKeyBox" Width="190" Margin="8,0,16,0"/><TextBlock Text="Spielname:" VerticalAlignment="Center"/><TextBox x:Name="GameNameBox" Width="180" Margin="8,0,16,0"/><TextBlock Text="Version:" VerticalAlignment="Center"/><TextBox x:Name="GameVersionBox" Width="80" Text="1.0" Margin="8,0,0,0"/></StackPanel><StackPanel Orientation="Horizontal"><CheckBox x:Name="UploadAsModBox" Content="Mod" VerticalAlignment="Center" Margin="0,0,10,0" Checked="UploadAsMod_Changed" Unchecked="UploadAsMod_Changed"/><ComboBox x:Name="UploadBaseGameBox" Width="190" DisplayMemberPath="Name" IsEnabled="False" Margin="0,0,10,0" ToolTip="Hauptspiel für den Mod auswählen"/><Button Content="Tags festlegen" Click="AddTags_Click" Padding="12,6" Margin="0,0,8,0"/><Button Content="ZIP/EXE hochladen" Click="Upload_Click" Padding="12,6" Margin="0,0,8,0"/><Button Content="Server-Inbox prüfen" Click="Inbox_Click" Padding="12,6" Margin="0,0,8,0"/><ComboBox x:Name="InboxFiles" Width="230" Margin="0,0,8,0"/><Button Content="Aus Inbox importieren" Click="Import_Click" Padding="12,6"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,7,0,0"><Button Content="Serverbibliothek Im-/Export" Click="LibraryTransfer_Click" Padding="12,6" Margin="0,0,8,0"/><Button Content="Serverbibliothek prüfen" Click="LibraryCheck_Click" Padding="12,6"/></StackPanel></StackPanel></GroupBox>
</Grid></Window>