<Window x:Class="LanLauncher.Client.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:LanLauncher.Client" Title="LAN Party Launcher" Width="1150" Height="760" MinWidth="900" MinHeight="620">
<Window.Resources><local:GameIconConverter x:Key="GameIconConverter"/></Window.Resources>
<Grid Margin="20">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Border Background="#000080" BorderBrush="#FFFFFF" BorderThickness="1" Margin="0,0,0,16" Padding="10,8"><DockPanel><TextBlock Text="LAN PARTY LAUNCHER" FontFamily="Tahoma" FontSize="20" FontWeight="Bold" Foreground="White"/></DockPanel></Border>
<StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12"><TextBlock Text="Server:" VerticalAlignment="Center"/><TextBox x:Name="ServerBox" Width="180" Margin="8,0,16,0" Text="127.0.0.1:8080"/><TextBlock Text="Benutzer:" VerticalAlignment="Center"/><TextBox x:Name="NameBox" Width="150" Margin="8,0,12,0"/><Button Content="Verbinden" Padding="14,6" Click="Connect_Click" IsDefault="True"/><Button Content="⚙ Einstellungen" Padding="14,6" Margin="12,0,0,0" Click="Settings_Click"/></StackPanel>
<TextBlock Grid.Row="2" x:Name="StatusText" Text="Nicht verbunden" Margin="0,0,0,14"/>
<Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><GroupBox Header="Spielebibliothek" Margin="0,0,8,0"><DockPanel><ListBox x:Name="GamesList" Margin="6" SelectionChanged="GamesList_SelectionChanged" MouseDoubleClick="GamesList_MouseDoubleClick">
<ListBox.ItemContainerStyle>
<Style TargetType="{x:Type ListBoxItem}">
<Setter Property="Foreground" Value="Black"/>
<Setter Property="Background" Value="White"/>
<Setter Property="Padding" Value="4,4"/>
<Style.Triggers>
<Trigger Property="IsSelected" Value="True">
<Setter Property="Background" Value="#D6E8FF"/>
<Setter Property="Foreground" Value="Black"/>
</Trigger>
</Style.Triggers>
</Style>
</ListBox.ItemContainerStyle>
<ListBox.ItemTemplate>
<DataTemplate>
<StackPanel Orientation="Horizontal">
<Image Source="{Binding Converter={StaticResource GameIconConverter}}" Width="18" Height="18" Margin="0,0,7,0" Stretch="Uniform"/>
<TextBlock Text="{Binding Name}" Foreground="#000000" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
</StackPanel>
</DataTemplate>
</ListBox.ItemTemplate>
</ListBox></DockPanel></GroupBox><GroupBox Header="Spieler online" Grid.Column="1" Margin="8,0,0,0"><ListBox x:Name="PlayersList" Margin="6"/></GroupBox></Grid>
<GroupBox Header="Admin – Spiele hinzufügen" Grid.Row="4" Margin="0,12,0,0"><StackPanel Margin="8"><StackPanel Orientation="Horizontal" Margin="0,0,0,6"><TextBlock Text="Admin-Schlüssel:" VerticalAlignment="Center"/><PasswordBox x:Name="AdminKeyBox" Width="190" Margin="8,0,16,0"/><TextBlock Text="Spielname:" VerticalAlignment="Center"/><TextBox x:Name="GameNameBox" Width="180" Margin="8,0,16,0"/><TextBlock Text="Version:" VerticalAlignment="Center"/><TextBox x:Name="GameVersionBox" Width="80" Text="1.0" Margin="8,0,0,0"/></StackPanel><StackPanel Orientation="Horizontal"><Button Content="ZIP/EXE hochladen" Click="Upload_Click" Padding="12,6" Margin="0,0,8,0"/><Button Content="Server-Inbox prüfen" Click="Inbox_Click" Padding="12,6" Margin="0,0,8,0"/><ComboBox x:Name="InboxFiles" Width="230" Margin="0,0,8,0"/><Button Content="Aus Inbox importieren" Click="Import_Click" Padding="12,6"/></StackPanel></StackPanel></GroupBox>
</Grid></Window>