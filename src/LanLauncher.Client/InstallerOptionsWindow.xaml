<Window x:Class="LanLauncher.Client.InstallerOptionsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="EXE-Installation" Width="610" Height="375" MinWidth="540" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
<Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<TextBlock x:Name="GameTitle" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>
<TextBlock Grid.Row="1" TextWrapping="Wrap" Margin="0,0,0,12" Text="Ein EXE-Installer verwendet eventuell einen eigenen Installationsordner. Bitte prüfe den Zielpfad im Installationsassistenten und passe ihn dort gegebenenfalls an. Nur bei unterstützten Installer-Typen kann der Launcher den Pfad als Vorschlag übergeben."/>
<StackPanel Grid.Row="2"><TextBlock Text="Gewünschter Installationsordner:" FontWeight="SemiBold"/><TextBlock x:Name="TargetPath" TextWrapping="Wrap" Margin="0,4,0,12"/><TextBlock Text="Installer-Typ:" FontWeight="SemiBold"/><ComboBox x:Name="InstallerTypeBox" SelectedIndex="0" Margin="0,4,0,8"><ComboBoxItem Content="Unbekannt / manuell (kein Parameter)" Tag="manual"/><ComboBoxItem Content="NSIS (Parameter /D=Pfad)" Tag="nsis"/><ComboBoxItem Content="Inno Setup (Parameter /DIR=Pfad)" Tag="inno"/></ComboBox><TextBlock Text="Wähle NSIS oder Inno Setup nur, wenn der Installer diesen Typ unterstützt. Die Auswahl wird für dieses Spiel gespeichert." TextWrapping="Wrap" Foreground="DimGray"/></StackPanel>
<StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Abbrechen" Width="110" Padding="8" Margin="0,0,8,0" IsCancel="True"/><Button Content="Installer starten" Width="145" Padding="8" IsDefault="True" Click="Start_Click"/></StackPanel>
</Grid></Window>